# The relays deploy.sh upgrades, in this order: one at a time, each serving the
# new build and healthy for SOAK seconds before the next is touched, so they are
# never all restarting at once. Put the relay your users list first last: it
# only gets a build that has already proven itself on the others.
#
# Copy this file to hosts.env (which git ignores) and fill in your own.
HOSTS="eu us"

# How to reach each: ssh options, then user@host (or an ~/.ssh/config alias).
SSH_OPTS_eu=""
SSH_DEST_eu="root@relay-eu.example.com"
SSH_OPTS_us="-i $HOME/.ssh/relay_us"
SSH_DEST_us="root@relay-us.example.com"

# Where the one build for all of them is tested and made (has a Rust toolchain).
BUILD_HOST=eu

# Seconds each host must stay healthy on the new build before the next starts.
SOAK=30
