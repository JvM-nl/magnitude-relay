# fastr, benchmark instance. Read by start.sh (sourced), not by fastr itself:
# fastr is configured through FASTR_* environment variables only.
# Everything not listed keeps its default.

# loopback only, port in the 7801-7809 benchmark range
FASTR_ADDR=127.0.0.1
FASTR_PORT=7801
FASTR_DATA_DIR=/root/bench/fastr-data

# Limits raised to at least ours (defaults in parentheses)
FASTR_MAX_CONNECTIONS=20000       # (1024)
FASTR_MAX_SUBSCRIPTIONS=200       # (20)
FASTR_MAX_LIMIT=5000              # (500)
FASTR_MAX_FILTER_VALUES=5000      # (4096)
FASTR_MAX_FILTERS=50              # (32), matches our relay's max_filters
FASTR_MAX_MESSAGE_BYTES=262144    # (2097152), matches our relay's max_message_bytes
FASTR_MAX_NEG_RECORDS=1000000     # (500000), matches strfry/ditto negentropy caps
